# ══════════════════════════════════════════════════════════════════════════════
# PaySure — Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env to source control.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, or local Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── App Settings ────────────────────────────────────────────────────────────
APP_NAME=PaySure
# Set to "production" when deploying. Controls docs visibility + log level.
APP_ENV=development
DEBUG=True

# A strong random secret. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

# ─── JWT Settings ────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Clerk (Authentication) ──────────────────────────────────────────────────
# Get from: Clerk Dashboard → API Keys. Use TEST keys for dev.
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_CLERK_SECRET_KEY
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_CLERK_PUBLISHABLE_KEY

# ─── Razorpay (SANDBOX / TEST MODE ONLY) ─────────────────────────────────────
# ⚠️  NEVER use Live keys here. Test keys only.
# Get from: https://dashboard.razorpay.com/app/keys → switch to Test mode
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_TEST_KEY_SECRET

# Webhook signing secret. Set in Razorpay Dashboard → Webhooks → Secret.
# For local webhook testing: use ngrok, then set this to your configured secret.
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET

# ─── Email ───────────────────────────────────────────────────────────────────
# Provider: "sendgrid" | "resend" | "" (empty = no-op, emails printed to log only)
EMAIL_PROVIDER=

# Sender address — must be verified with your chosen provider
EMAIL_FROM=noreply@yourdomain.com

# SendGrid API key (required if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# Resend API key (required if EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# ─── Application URLs ────────────────────────────────────────────────────────
# Used in email deep-links and CORS. Update to your production domain when deploying.
FRONTEND_URL=http://localhost:5173

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Lock this down in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ══════════════════════════════════════════════════════════════════════════════
# PRODUCTION CHECKLIST — do not enable live payments until all items are done:
# [ ] Set APP_ENV=production and DEBUG=False
# [ ] Generate a new unique SECRET_KEY for production (not reused from dev)
# [ ] Replace Razorpay TEST keys with LIVE keys (after merchant verification)
# [ ] Set RAZORPAY_WEBHOOK_SECRET to your production webhook secret
# [ ] Configure a real email provider (EMAIL_PROVIDER=sendgrid or resend)
# [ ] Update FRONTEND_URL to your production domain
# [ ] Lock ALLOWED_ORIGINS to your production domain only
# [ ] Rotate DATABASE_URL to production DB credentials
# [ ] Complete Razorpay merchant KYC/onboarding for live payments
# ══════════════════════════════════════════════════════════════════════════════
